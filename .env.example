# Copia este archivo a .env.local y completa los valores. Nunca subas valores reales al repo.

# Neon (los inyecta la integración de Vercel en Preview y Production)
DATABASE_URL=
# Conexión directa, sin pooler: la usa drizzle-kit para migrar (ADR 0016)
DATABASE_URL_UNPOOLED=

# Local y CI: "pg" usa node-postgres contra un Postgres normal (ADR 0013). Vacío en Vercel.
DB_DRIVER=

# Secreto del HMAC de las IP para los límites contra abuso (ADR 0010). Obligatorio.
RATE_LIMIT_SECRET=
# Tope global de citas nuevas por día (opcional, por defecto 40)
MAX_DAILY_BOOKINGS=
# Número de WhatsApp del concesionario, solo dígitos con prefijo (opcional, por defecto 34600000000)
WHATSAPP_NUMBER=

# Secreto de las sesiones de Auth.js (ADR 0008). Obligatorio.
AUTH_SECRET=

# Primer admin: el build lo crea si no existe (ADR 0016). Contraseña de 12 caracteres o más.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Solo para pruebas: si está definida, la prueba de health verifica la conexión real (SPRINT0 DoD 3)
TEST_DATABASE_URL=
